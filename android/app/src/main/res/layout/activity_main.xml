<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="?android:colorBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="16dp">
            <ImageButton
                android:id="@+id/navigationButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_navigation"
                android:padding="16dp"
                android:src="@drawable/ic_menu" />
            <LinearLayout
                android:id="@+id/screenTitleContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/reader_primary_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/chapterEnglishTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/reader_secondary_text"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeScreen"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="54dp"
                android:contentDescription="@string/app_icon_description"
                android:src="@drawable/ic_bible" />
            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/home_title"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/home_description"
                android:textSize="16sp" />
            <Button
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="@string/continue_reading" />
            <Button
                android:id="@+id/browseButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/browse_books" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/booksControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone"
            tools:ignore="UselessParent">
            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/oldTestamentButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/old_testament" />
                <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/newTestamentButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/new_testament" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/readerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/plainButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/plain" android:textAllCaps="false" android:textSize="13sp" />
                    <View android:id="@+id/plainIndicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/chapter_indicator" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/sideButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/side_by_side" android:textAllCaps="false" android:textSize="13sp" />
                    <View android:id="@+id/sideIndicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/chapter_indicator" android:visibility="gone" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/followButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/follow_up" android:textAllCaps="false" android:textSize="13sp" />
                    <View android:id="@+id/followIndicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/chapter_indicator" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/plainEditionSelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edition_selector_background"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/editionIgboButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/edition_segment_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/plain_igbo"
                    android:textColor="@color/reader_primary_text"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/editionKjvButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/edition_segment_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/plain_kjv"
                    android:textColor="@color/reader_primary_text"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton android:id="@+id/previousChapterButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/previous_chapter" android:padding="13dp" android:src="@drawable/ic_chevron_left" />
                <TextView android:id="@+id/chapterNavigationLabel" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="@string/chapter_navigation" android:textColor="@color/reader_primary_text" android:textSize="14sp" />
                <ImageButton android:id="@+id/nextChapterButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/next_chapter" android:padding="13dp" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/loading"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/aboutScreen"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_purpose_title" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/about_purpose" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/about_version_title" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/about_creator_title" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/aboutCreatorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/about_creator" android:textColor="@color/reader_primary_text" android:textSize="16sp" />
            <TextView android:id="@+id/aboutCreatorDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/about_creator_description" android:textColor="@color/reader_secondary_text" android:textSize="14sp" />
            <TextView android:id="@+id/websiteText" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/about_website" android:textColor="@color/website_link" android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bottomAdSlot"
            style="@style/FutureAdSlotContainer"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?android:colorBackground"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:paddingHorizontal="24dp" android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold" />
        <include layout="@layout/row_navigation_home" />
        <include layout="@layout/row_navigation_books" />
        <include layout="@layout/row_navigation_about" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
