<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chapter_tile_selected_surface" />
            <stroke android:width="2dp" android:color="@color/chapter_tile_selected_border" />
            <corners android:radius="@dimen/chapter_tile_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chapter_tile_surface" />
            <stroke android:width="1dp" android:color="@color/chapter_tile_border" />
            <corners android:radius="@dimen/chapter_tile_corner_radius" />
        </shape>
    </item>
</selector>
